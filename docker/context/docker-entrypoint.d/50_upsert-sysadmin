#!/usr/bin/env ruby
Dir.chdir("/home/decidim") do
  exit 0 unless ENV["DECIDIM_SYSTEM_EMAIL"] && ENV["DECIDIM_SYSTEM_PASSWORD"]
  puts "#{__FILE__}:"
  ok = system("bundle", "exec", "rails", "runner", <<~RUBY)
    admin = Decidim::System::Admin.find_or_initialize_by(email: ENV.fetch("DECIDIM_SYSTEM_EMAIL"))
    admin.password_confirmation = admin.password = ENV.fetch("DECIDIM_SYSTEM_PASSWORD")
    admin.save!
  RUBY
  raise "Failed to upsert /system admin, abort" unless ok
  puts "    ✅ /system DECIDIM_SYSTEM_EMAIL account updated."
end
