#!/usr/bin/env ruby

APP_ROOT = "/home/decidim"

def wait_for_redis
  return if ENV.fetch("REDIS_URL", "").empty?
  redis_uri = URI.parse(ENV["REDIS_URL"])
  host = redis_uri.host
  port = (redis_uri.port || 6379).to_s
  raise "Redis #{host}:#{port} is not available, abort" unless system("wait-for-it", "-h", host, "-p", port)
  puts "    ✅ redis is up"
end

def load_rails_application
  require File.join(APP_ROOT, "config/application")
end

def current_db_config
  env = ENV.fetch("RAILS_ENV", "production")
  ActiveRecord::Base.configurations = Rails.application.config.database_configuration
  cfg = ActiveRecord::Base.configurations.configs_for(env_name: env).first
  raise "No database configuration for #{env}, abort" unless cfg
  cfg.configuration_hash
end

def uri_endpoint(url)
  uri = URI.parse(url)
  raise "Database URL in Rails config is malformed, abort" if uri.host.to_s.empty?
  [uri.host, (uri.port || 5432).to_s, uri.user]
end

def database_endpoint(hash)
  return uri_endpoint(hash[:url]) if hash[:url].to_s != ""
  host = hash[:host].to_s
  raise "Database host missing in Rails config, abort" if host.empty?
  [host, (hash[:port] || 5432).to_s, hash[:username]]
end

def postgresql_config?(hash)
  adapter = hash[:adapter].to_s
  url = hash[:url].to_s
  adapter.match?(/postgres|postgis/) || url.match?(/\A(?:jdbc:)?(?:postgres|postgis)/)
end

def wait_for_database
  hash = current_db_config
  return unless postgresql_config?(hash)
  host, port, user = database_endpoint(hash)
  puts "    database is configured, waiting for server"
  args = ["pg_isready", "-h", host, "-p", port, "-t", "30"]
  args.push("-U", user) if user.to_s != ""
  raise "Database is not available, abort" unless system(*args)
  puts "    ✅ database is up"
end

def wait_for_memcached
  return if ENV.fetch("MEMCACHE_SERVERS", "").empty?
  puts "    memcached is configured, waiting for servers"
  memcache_servers = ENV["MEMCACHE_SERVERS"].split(",").map(&:strip)
  memcache_is_up = memcache_servers.map do |memcache_server|
    (host, port) = memcache_server.strip.split(":")
    system("wait-for-it", "-h", host, "-p", port || "11211")
  end.any?
  raise "No memcache server available, abort" unless memcache_is_up
end

Dir.chdir(APP_ROOT) do
  puts "#{__FILE__}:"
  load_rails_application
  wait_for_redis
  wait_for_database
  wait_for_memcached
end
