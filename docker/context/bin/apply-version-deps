#!/usr/bin/env bash
set -euo pipefail

VERSION_DEPS_ROOT="${VERSION_DEPS_ROOT:-/usr/local/share/version-deps}"
DECIDIM_VERSION="${DECIDIM_VERSION:?DECIDIM_VERSION is required}"

minor_version() {
  local version="${DECIDIM_VERSION%.dev}"
  echo "${version}" | sed -E 's/^([0-9]+\.[0-9]+).*/\1/'
}

list_overlay() {
  local kind="$1"
  local minor
  minor="$(minor_version)"
  local file="${VERSION_DEPS_ROOT}/${minor}/${kind}.txt"
  if [[ -f "$file" ]]; then
    grep -v '^#' "$file" | sed '/^[[:space:]]*$/d' || true
  fi
}

# gems.txt: "commonmarker" or "selma < 0.5" → Gemfile lines.
emit_gemfile() {
  list_overlay gems | while read -r name rest; do
    [ -z "$name" ] && continue
    if [ -n "$rest" ]; then
      printf "gem '%s', '%s'\n" "$name" "$rest"
    else
      printf "gem '%s'\n" "$name"
    fi
  done
}

append_gemfile() {
  local gf="${1:-Gemfile}"
  emit_gemfile | while IFS= read -r line; do
    grep -qxF "$line" "$gf" || echo "$line" >> "$gf"
  done
}

case "${1:-}" in
  list)
    list_overlay "${2:-}"
    ;;
  gemfile)
    emit_gemfile
    ;;
  append-gemfile)
    append_gemfile "${2:-Gemfile}"
    ;;
  *)
    echo "usage: apply-version-deps list <gems|npm|ubuntu|redhat> | gemfile | append-gemfile [Gemfile]" >&2
    exit 1
    ;;
esac
