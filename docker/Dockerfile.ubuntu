ARG UBUNTU_TAG
ARG NODE_MAJOR_VERSION=20

# Single base with all dependencies
FROM ubuntu:${UBUNTU_TAG:-latest} AS base
ARG DECIDIM_VERSION
ARG DECIDIM_BRANCH  
ARG NODE_MAJOR_VERSION
ARG BUNDLER_VERSION
ARG RUBY_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=UTC \
    DECIDIM_VERSION=$DECIDIM_VERSION \
    NODE_MAJOR_VERSION=$NODE_MAJOR_VERSION \
    BUNDLER_VERSION=$BUNDLER_VERSION \
    DECIDIM_BRANCH=$DECIDIM_BRANCH \
    RUBY_VERSION=$RUBY_VERSION \
    WORK_DIR=/home/decidim \
    HOME=/home/decidim \
    PATH="/home/decidim/.rbenv/bin:/home/decidim/.rbenv/shims:${PATH}"

SHELL ["/bin/bash", "-o", "pipefail", "-l", "-c"]
WORKDIR $WORK_DIR

# Single comprehensive package installation
RUN apt-get update -yq \
  && apt-get install -yq --no-install-recommends \
    build-essential \
    ca-certificates \
    wget \
    git \
    gnupg \
    libffi-dev \
    libicu-dev \
    libpq-dev \
    libssl-dev \
    libvips-dev \
    libxml2-dev \
    libxslt1-dev \
    libyaml-dev \
    libjemalloc2 \
    python3-pip \
    python3-setuptools \
    rustc \
    tzdata \
    vim \
    zlib1g-dev \
  # Install Node.js from NodeSource
  && wget -qO- https://deb.nodesource.com/setup_${NODE_MAJOR_VERSION}.x | bash - \
  && apt-get install -yq --no-install-recommends nodejs \
  # Install rbenv and Ruby
  && git clone --depth 1 https://github.com/rbenv/rbenv.git ~/.rbenv \
  && git clone --depth 1 https://github.com/rbenv/ruby-build.git ~/.rbenv/plugins/ruby-build \
  && echo 'export PATH="$HOME/.rbenv/bin:$PATH"' >> ~/.bashrc \
  && echo 'eval "$(rbenv init -)"' >> ~/.bashrc \
  && CONFIGURE_OPTS="--disable-install-rdoc --enable-shared --enable-yjit" ~/.rbenv/bin/rbenv install "$RUBY_VERSION" \
  && ~/.rbenv/bin/rbenv global "$RUBY_VERSION" \
  && ~/.rbenv/bin/rbenv rehash \
  # Configure gems and bundler
  && echo "gem: --no-document" >> /etc/gemrc \
  && ~/.rbenv/shims/gem install bundler -v $BUNDLER_VERSION \
  && ~/.rbenv/shims/bundle config set build.charlock_holmes -- --with-cxxflags='#' --global \
  # Install Yarn
  && npm install -g yarn \
  # Cleanup
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* ~/.cache

##
# Generator Image - NOW USES base INSTEAD OF DUPLICATING
##
FROM base AS generator
ENV LD_PRELOAD="/usr/lib/x86_64-linux-gnu/libjemalloc.so.2" \
    MALLOC_CONF="dirty_decay_ms:1000,narenas:2,background_thread:true" \
    BUNDLE_APP_CONFIG="/home/decidim/.bundle" \
    BUNDLE_PATH="/home/decidim/vendor" \
    BUNDLE_DISABLE_SHARED_GEMS=true \
    DECIDIM_SPAM_DETECTION_BACKEND_RESOURCE=memory \
    DECIDIM_SPAM_DETECTION_BACKEND_USER=memory \
    RAILS_ENV=development \
    PATH="/home/decidim/bin:${PATH}" 

SHELL ["/bin/bash", "-o", "pipefail", "-l", "-c"]

# Generate Decidim app
RUN git clone --branch $DECIDIM_BRANCH --depth 1 https://github.com/decidim/decidim.git /home/decidim/generator
WORKDIR /home/decidim/generator/decidim-generators

RUN bundle config set path "vendor" --global \
  && bundle install \
  && bundle exec exe/decidim --branch $DECIDIM_BRANCH $WORK_DIR/rails_app \
  && bundle config unset path --global

WORKDIR $WORK_DIR

# Clean up and move app
RUN rm -rf rails_app/.git rails_app/node_modules rails_app/.npm rails_app/tmp \
    rails_app/config/master.key rails_app/config/credentials.yml.enc \
  && mv rails_app/* . \
  && mkdir -p tmp/pids tmp/sockets \
  && rm -rf generator rails_app

COPY ./context .

# Install app dependencies
RUN bundle config set without "development:test" \
  && bundle config set path "vendor" --global \
  && echo "ruby-$RUBY_VERSION" > $WORK_DIR/.ruby-version \
  && echo "eval_gemfile 'Gemfile.modules' if File.exist?('Gemfile.modules')" >> Gemfile \
  && bundle install \
  && bundle config set frozen true \
  && bundle config set deployment true \
  && rm bin/* \
  && bundle binstubs --all \
  && rails app:update:bin

##
# Final Decidim Image
##
FROM ubuntu:${UBUNTU_TAG:-latest} AS decidim
ARG BUILD_DATE
ARG VCS_REF  
ARG VERSION
ARG UBUNTU_TAG
ARG NODE_MAJOR_VERSION
ARG RUBY_VERSION
ARG BUNDLER_VERSION
ARG DECIDIM_BRANCH
ARG DECIDIM_VERSION

LABEL org.label-schema.build-date=${BUILD_DATE} \
      org.label-schema.name="decidim" \
      org.label-schema.description="Decidim application on Ubuntu ${UBUNTU_TAG:-latest}" \
      org.label-schema.url="https://github.com/decidim/docker" \
      org.label-schema.vcs-ref=${VCS_REF} \
      org.label-schema.vcs-url="https://github.com/decidim/decidim" \
      org.label-schema.vendor="Decidim" \
      org.label-schema.version=${VERSION} \
      org.label-schema.schema-version="1.0.0-rc.1" \
      org.opencontainers.image.created=${BUILD_DATE} \
      org.opencontainers.image.title="decidim" \
      org.opencontainers.image.description="Decidim application on Ubuntu ${UBUNTU_TAG:-latest}" \
      org.opencontainers.image.url="https://github.com/decidim/decidim" \
      org.opencontainers.image.revision=${VCS_REF} \
      org.opencontainers.image.source="https://github.com/decidim/decidim" \
      org.opencontainers.image.vendor="Decidim" \
      org.opencontainers.image.version=${VERSION} \
      org.opencontainers.image.licenses="GPL-3.0" \
      maintainer="Decidim Product Team <https://meta.decidim.org/profiles/product/members>"

ENV BUNDLE_APP_CONFIG="/home/decidim/.bundle" \
    BUNDLE_PATH="/home/decidim/vendor" \
    BUNDLE_DISABLE_SHARED_GEMS=true \
    NODE_MAJOR_VERSION=$NODE_MAJOR_VERSION \
    RUBY_VERSION=$RUBY_VERSION \
    BUNDLER_VERSION=$BUNDLER_VERSION \
    DECIDIM_BRANCH=$DECIDIM_BRANCH \
    DECIDIM_VERSION=$DECIDIM_VERSION \
    DECIDIM_SPAM_DETECTION_BACKEND_RESOURCE=memory \
    DECIDIM_SPAM_DETECTION_BACKEND_USER=memory \
    RAILS_ENV=production \
    WORK_DIR=/home/decidim \
    HOME=/home/decidim \
    PATH="/home/decidim/.rbenv/bin:/home/decidim/.rbenv/shims:${PATH}"
  
# SMTP Configuration
ENV SMTP_ADDRESS="" \
    SMTP_DOMAIN="" \
    SMTP_USERNAME="" \
    SMTP_PASSWORD="" \
    SMTP_PORT=587 \
    SMTP_STARTTLS_AUTO=true \
    SMTP_AUTHENTICATION=plain 
# Maps Configuration  
ENV MAPS_PROVIDER="" \
    MAPS_API_KEY="" 
# Storage Configuration
ENV STORAGE_PROVIDER=local 
# Rails Configuration
ENV RAILS_ENV=production \
    RAILS_LOG_LEVEL=debug \
    RAILS_MAX_THREADS=5 \
    RAILS_LOG_TO_STDOUT=true \
    RAILS_SERVE_STATIC_FILES=false \
    PORT=3000 \
    EDITOR=vim \
    PATH="/home/decidim/bin:${PATH}"
# Decidim Core Configuration
ENV DECIDIM_APPLICATION_NAME="My Application Name" \
    DECIDIM_MAILER_SENDER="change-me@example.org" \
    DECIDIM_AVAILABLE_LOCALES="en" \
    DECIDIM_DEFAULT_LOCALE=en \
    DECIDIM_FORCE_SSL=auto \
    DECIDIM_TRACK_NEWSLETTER_LINKS=true \
    DECIDIM_ADMIN_PASSWORD_STRONG=true \
    DECIDIM_SERVICE_WORKER_ENABLED=false 
# Decidim Spam Detection
ENV DECIDIM_SPAM_DETECTION_BACKEND_RESOURCE=memory \
    DECIDIM_SPAM_DETECTION_BACKEND_USER=memory

# Install Node.js from NodeSource
RUN apt-get update -yq \
  && apt-get install -yq --no-install-recommends \
    ca-certificates \
    wget \
    cron \
    libpq5 \
    libvips42 \
    libyaml-0-2 \ 
    libjemalloc2 \
    tzdata \
    zlib1g \
  && wget -qO- https://deb.nodesource.com/setup_${NODE_MAJOR_VERSION}.x | bash -  \
  && apt-get install -yq --no-install-recommends nodejs \
  && apt-get purge -y --auto-remove wget \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* ~/.cache \
## Set up user and working directory
  && groupadd -g 1001 decidim \
  && useradd -u 1001 -g decidim -m decidim \
  && touch /etc/motd \
  && chown decidim:decidim /etc/motd  \
  && npm install -g yarn \
  && rm -rf /home/ubuntu

ENV LD_PRELOAD="/usr/lib/x86_64-linux-gnu/libjemalloc.so.2" \
    MALLOC_CONF="dirty_decay_ms:1000,narenas:2,background_thread:true" 
USER decidim
WORKDIR $WORK_DIR
COPY --from=generator --chown=decidim:decidim /home/decidim /home/decidim
RUN bundle config set path /home/decidim/vendor \
    && (bundle check || exit 1)
EXPOSE 3000
ENTRYPOINT ["/home/decidim/entrypoint.sh"]
CMD ["bundle", "exec", "rails", "s", "-b", "0.0.0.0"]
