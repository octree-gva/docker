services:
  # As example, we use here nginx.
  # Feel free to use any other proxy, like HaProxy, etc.
  nginx:
    container_name: proxy
    build:
      dockerfile_inline: |
        FROM nginx:1.25-alpine
        RUN mkdir -p /var/nginx/tmp && chown -R nginx:nginx /var/nginx
        ADD https://raw.githubusercontent.com/<%= github_repository %>/<%= github_ref_name %>/contrib/nginx/nginx.conf /etc/nginx/nginx.conf
    networks:
      - private
      - default
    links:
      - decidim
    ports:
      - 8080:8080
    depends_on:
      - decidim
    volumes:
      - decidim_public:/usr/share/nginx/html:ro

  decidim:
    container_name: decidim
    image: <%= registry_username %>/decidim:<%= prev_version.decidim_version %>
    ports:
      - "3000:3000"
    environment:
      - DATABASE_ADAPTER=postgresql
      - DATABASE_URL=postgres://postgres:postgres@db:5432/decidim_production
      - REDIS_URL=redis://redis:6379/0
      - DECIDIM_SPAM_DETECTION_BACKEND_RESOURCE=memory
      - DECIDIM_SPAM_DETECTION_BACKEND_USER=memory
      - SECRET_KEY_BASE=insecure_key_base
      - RAILS_ENV=production
      - NODE_ENV=production
      - DECIDIM_FORCE_SSL=false
      - DECIDIM_MAILER_SENDER=changeme@example.org
      - DECIDIM_SYSTEM_EMAIL=hello@example.org
      - DECIDIM_SYSTEM_PASSWORD=my_insecure_password
      - QUEUE_ADAPTER=async
      - SMTP_ADDRESS=mailcatcher
      - SMTP_PORT=1025
      - SMTP_AUTHENTICATION=plain
    volumes:
      - decidim_public:/home/decidim/public
    networks:
      - private
    depends_on:
      - redis
      - db
      - mailcatcher

  db:
    image: postgres:17
    environment:
      - POSTGRES_PASSWORD=postgres
      - POSTGRES_USER=postgres
      - POSTGRES_DB=decidim_production
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - private

  redis:
    image: redis:7
    volumes:
      - redis_data:/data
    networks:
      - private

  mailcatcher:
    image: sj26/mailcatcher
    ports:
      - "1080:1080"
    networks:
      - private

volumes:
  decidim_public:
  redis_data:
  postgres_data:

networks:
  private:
